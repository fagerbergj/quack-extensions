{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quack.example/sleeper/ui/schemas/trends.json",
  "title": "trends",
  "description": "Timeline of what changed: injuries/practice, waiver heat, beat-reporter news.",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "time",
          "source",
          "kind",
          "text"
        ],
        "properties": {
          "time": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "injury",
              "waiver",
              "news",
              "note"
            ]
          },
          "player": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "pos": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "team": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "inj": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "prac": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "proj": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "text": {
            "type": "string"
          },
          "link": {
            "type": "string"
          }
        }
      }
    },
    "source_note": {
      "type": "string"
    }
  },
  "required": [
    "items"
  ]
}
