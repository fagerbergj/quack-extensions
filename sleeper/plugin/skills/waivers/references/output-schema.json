{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quack.example/sleeper/ui/schemas/waivers.json",
  "title": "waivers",
  "description": "Ranked waiver-wire targets for the next run, with a drop suggestion each.",
  "type": "object",
  "properties": {
    "week": {
      "type": "integer"
    },
    "summary": {
      "type": "string",
      "maxLength": 400
    },
    "waiver_type": {
      "type": "string",
      "maxLength": 40,
      "description": "As sleeper_league reports it: rolling / reverse standings / FAAB."
    },
    "my_priority": {
      "type": [
        "integer",
        "null"
      ]
    },
    "teams": {
      "type": [
        "integer",
        "null"
      ]
    },
    "candidates": {
      "type": "array",
      "description": "Ordered as the claims to submit; rank is the claim order.",
      "items": {
        "type": "object",
        "required": [
          "player",
          "proj"
        ],
        "properties": {
          "rank": {
            "type": [
              "integer",
              "null"
            ]
          },
          "player": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "pos": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "team": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "inj": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "prac": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "proj": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "proj": {
            "type": "number"
          },
          "owned_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "adds_24h": {
            "type": [
              "integer",
              "null"
            ]
          },
          "drop": {
            "type": "string",
            "maxLength": 80
          },
          "why": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    },
    "also_checked": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "player",
          "why"
        ],
        "properties": {
          "player": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "pos": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "team": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "inj": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "prac": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "proj": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "why": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    },
    "source_note": {
      "type": "string",
      "maxLength": 300
    }
  },
  "required": [
    "week",
    "candidates"
  ]
}
